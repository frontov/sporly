# Telegram
BOT_TOKEN=
# Optional socks5/http proxy for api.telegram.org
TELEGRAM_PROXY=

# Backend catalog
API_BASE_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=30
API_CACHE_TTL_SECONDS=90
FILTER_CACHE_TTL_SECONDS=3600

# Admin commands (/admin, /stats, /partners, /broadcast)
ADMIN_TOKEN=
ADMIN_TELEGRAM_IDS=

# Delivery
POLL_INTERVAL_SECONDS=900
DIGEST_HOUR_UTC=6
# Optional: winter, spring, summer, autumn
SEASON_OVERRIDE=
REMINDER_CHECK_INTERVAL_SECONDS=3600
MAX_NOTIFICATIONS_PER_TICK=4
MAX_NOTIFICATIONS_PER_DAY=8
DROP_PENDING_UPDATES=false

# Growth / monetization
# Public HTTPS origin used for tracked partner links, e.g. https://sporly.ru
PUBLIC_BASE_URL=
PARTNER_CONTACT=@fronteno
PARTNER_IMPRESSION_PER_USER_DAY=1
PARTNER_CONFIG_FILE=app/config/partners.json

# Local server for /go/<partner> redirects
REDIRECT_HOST=0.0.0.0
REDIRECT_PORT=8081

# Storage
# DATABASE_FILE=app/data/sporly.db

# Public site link used by /app
WEBAPP_URL=https://sporly.ru
